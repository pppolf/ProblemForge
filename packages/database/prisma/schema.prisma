generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum SystemRole {
  ADMIN
  USER
}
enum ResourceRole {
  OWNER
  EDITOR
  REVIEWER
  VIEWER
  TRANSLATOR
}
enum DocumentKind {
  STATEMENT
  EDITORIAL_DOCUMENT
  EDITORIAL_BEAMER
}
enum TemplateState {
  DRAFT
  VALIDATED
  PUBLISHED
  ARCHIVED
  REVOKED
}
enum BuildState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  associationUserId String? @unique
  associationAccount String?
  role SystemRole @default(USER)
  disabled Boolean @default(false)
  version Int @default(1)
  passwordResetRequired Boolean @default(false)
  passwordReset PasswordReset?
  createdAt DateTime @default(now())
  sessions Session[]
  memberships ProblemMember[]
  builds Build[]
  testRuns TestRun[]
  groupMemberships UserGroupMember[]
  contestMemberships ContestMember[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
  @@index([userId])
}
model PasswordReset {
  id String @id
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model Problem {
  id String @id @default(cuid())
  title String
  archived Boolean @default(false)
  version Int @default(1)
  tags String[] @default([])
  notes String @default("") @db.Text
  responsibleId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members ProblemMember[]
  documents Document[]
  assets Asset[]
  judgeVersion Int @default(1)
  judgeSettings Json?
  programs Program[]
  tests TestCase[]
  generatorPlans GeneratorPlan[]
  selfTests ToolSelfTest[]
  testRuns TestRun[]
  stressConfig StressConfig?
  testGroupConfig TestGroupConfig?
  groupMembers ProblemGroupMember[]
  revisions ProblemRevision[]
  @@index([createdAt, id])
}
model ProblemMember {
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role ResourceRole
  languages String[] @default([])
  @@id([problemId, userId])
}
model Document {
  id String @id @default(cuid())
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language String
  kind DocumentKind
  enabled Boolean @default(true)
  version Int @default(1)
  currentRevisionId String? @unique
  currentRevision ContentRevision? @relation("CurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  templateVersionId String?
  templateVersion TemplateVersion? @relation(fields: [templateVersionId], references: [id])
  revisions ContentRevision[] @relation("DocumentHistory")
  publications Publication[]
  updatedAt DateTime @updatedAt
  @@unique([problemId, language, kind])
}
model ContentRevision {
  id String @id @default(cuid())
  documentId String
  document Document @relation("DocumentHistory", fields: [documentId], references: [id], onDelete: Cascade)
  version Int
  body String @db.Text
  metadata Json
  sampleRevisionIds String[] @default([])
  hash String
  createdAt DateTime @default(now())
  currentFor Document? @relation("CurrentRevision")
  @@unique([documentId, version])
}
model Template {
  id String @id @default(cuid())
  name String
  kind DocumentKind
  createdAt DateTime @default(now())
  versions TemplateVersion[]
}
model TemplateVersion {
  id String @id @default(cuid())
  templateId String
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  number Int
  editVersion Int @default(1)
  state TemplateState @default(DRAFT)
  files Json
  styleConfig Json?
  hash String
  validationBuildId String?
  validationBuildHash String?
  publishedAt DateTime?
  reason String?
  createdAt DateTime @default(now())
  documents Document[]
  @@unique([templateId, number])
}
model Build {
  id String @id @default(cuid())
  requestKey String? @unique
  leaseToken String?
  heartbeatAt DateTime?
  retryOfId String? @unique
  retryCount Int @default(0)
  cacheSourceId String?
  updatedAt DateTime @default(now()) @updatedAt
  requestedById String
  requestedBy User @relation(fields: [requestedById], references: [id])
  problemId String?
  contestId String?
  contestRevisionId String?
  bundleId String?
  documentId String?
  revisionId String?
  templateVersionId String
  kind DocumentKind
  purpose String @default("DOCUMENT")
  state BuildState @default(QUEUED)
  input Json
  inputHash String
  log String @default("") @db.Text
  diagnostics Json?
  errorCode String?
  queuedAt DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  cancelRequested Boolean @default(false)
  createdAt DateTime @default(now())
  artifacts Artifact[]
  publications Publication[]
  @@index([state, queuedAt])
  @@index([problemId, documentId, createdAt])
  @@index([requestedById, createdAt, id])
  @@index([problemId, createdAt, id])
  @@index([contestId, createdAt, id])
}
model Artifact {
  id String @id @default(cuid())
  buildId String
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)
  key String @unique
  mediaType String
  hash String
  bytes Int
  createdAt DateTime @default(now())
}
model Asset {
  id String @id @default(cuid())
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  name String
  key String @unique
  mediaType String
  hash String
  bytes Int
  createdAt DateTime @default(now())
}
model Publication {
  id String @id @default(cuid())
  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  buildId String
  build Build @relation(fields: [buildId], references: [id])
  token String @unique
  revokedAt DateTime?
  createdAt DateTime @default(now())
}
model WorkerHeartbeat {
  id String @id
  kind String
  heartbeatAt DateTime @default(now())
  startedAt DateTime @default(now())
  @@index([kind, heartbeatAt])
}
model StoredObject {
  key String @id
  hash String
  bytes BigInt
  ready Boolean @default(false)
  createdAt DateTime @default(now())
}
model CompileCache {
  id String @id
  problemId String
  sourceRunId String
  key String
  hash String
  bytes Int
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  resourceId String?
  detail Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model UserGroup {
  id String @id @default(cuid())
  name String @unique
  version Int @default(1)
  members UserGroupMember[]
  problems ProblemGroupMember[]
  contests ContestGroupMember[]
}
model UserGroupMember {
  groupId String
  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([groupId, userId])
}
model ProblemGroupMember {
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  groupId String
  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role ResourceRole
  languages String[] @default([])
  @@id([problemId, groupId])
}
model ProblemRevision {
  id String @id @default(cuid())
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  number Int
  label String
  manifest Json
  hash String
  reviewHash String
  judgeHash String?
  acceptanceRunId String?
  state String @default("DRAFT")
  createdById String
  createdAt DateTime @default(now())
  frozenAt DateTime?
  comments ReviewComment[]
  decisions ReviewDecision[]
  @@unique([problemId, number])
}
model ReviewComment {
  id String @id @default(cuid())
  revisionId String
  revision ProblemRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  authorId String
  body String @db.Text
  anchor String @default("")
  resolved Boolean @default(false)
  createdAt DateTime @default(now())
}
model ReviewDecision {
  id String @id @default(cuid())
  revisionId String
  revision ProblemRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  authorId String
  action String
  message String @db.Text
  reviewHash String
  createdAt DateTime @default(now())
}
model Contest {
  id String @id @default(cuid())
  title String
  version Int @default(1)
  archived Boolean @default(false)
  data Json
  members ContestMember[]
  groupMembers ContestGroupMember[]
  revisions ContestRevision[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ContestMember {
  contestId String
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role ResourceRole
  @@id([contestId, userId])
}
model ContestGroupMember {
  contestId String
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  groupId String
  group UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role ResourceRole
  @@id([contestId, groupId])
}
model ContestRevision {
  id String @id @default(cuid())
  contestId String
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  number Int
  data Json
  hash String
  createdById String
  createdAt DateTime @default(now())
  @@unique([contestId, number])
}
model ExportArtifact {
  id String @id @default(cuid())
  problemId String?
  contestId String?
  revisionId String
  requestedById String
  purpose String
  format String
  key String @unique
  hash String
  bytes Int
  report Json
  createdAt DateTime @default(now())
  publications Release[]
}
model Release {
  id String @id @default(cuid())
  problemId String?
  contestId String?
  purpose String
  artifactId String?
  exportId String?
  exported ExportArtifact? @relation(fields: [exportId], references: [id])
  token String @unique
  revokedAt DateTime?
  createdAt DateTime @default(now())
}
enum ProgramRole {
  MAIN_SOLUTION
  CORRECT_SOLUTION
  WRONG_SOLUTION
  TIME_LIMIT_SOLUTION
  BRUTE_FORCE
  GENERATOR
  VALIDATOR
  EXTRA_VALIDATOR
  CHECKER
  INTERACTOR
}
enum ProgramLanguage {
  CPP17
  CPP20
  PYTHON3
  C17
  CPP23
  JAVA17
}
enum JudgePurpose {
  COMPILE
  GENERATE
  VALIDATE
  ANSWERS
  SELF_TEST
  ACCEPTANCE
  STRESS
  REPLAY
}
model StressConfig {
  problemId String @id
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  version Int
  data Json
  hash String
  revisions StressConfigRevision[]
}
model StressConfigRevision {
  id String @id @default(cuid())
  problemId String
  config StressConfig @relation(fields: [problemId], references: [problemId], onDelete: Cascade)
  version Int
  data Json
  hash String
  createdAt DateTime @default(now())
  @@unique([problemId, version])
}
model TestGroupConfig {
  problemId String @id
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  version Int
  data Json
  hash String
  revisions TestGroupConfigRevision[]
}
model TestGroupConfigRevision {
  id String @id @default(cuid())
  problemId String
  config TestGroupConfig @relation(fields: [problemId], references: [problemId], onDelete: Cascade)
  version Int
  data Json
  hash String
  createdAt DateTime @default(now())
  @@unique([problemId, version])
}
model CompileProfile {
  id String @id
  name String
  language ProgramLanguage
  version Int @default(1)
  enabled Boolean @default(true)
  config Json
  hash String
  updatedAt DateTime @updatedAt
  programs Program[]
}
model Program {
  id String @id @default(cuid())
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  name String
  role ProgramRole
  profileId String
  profile CompileProfile @relation(fields: [profileId], references: [id])
  expectedVerdicts Json
  expectedScore Json?
  validatorScope String @default("GLOBAL")
  notes String @default("")
  enabled Boolean @default(true)
  version Int @default(1)
  currentRevisionId String? @unique
  currentRevision ProgramRevision? @relation("CurrentProgramRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  revisions ProgramRevision[] @relation("ProgramHistory")
  plans GeneratorPlan[]
  selfTests ToolSelfTest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([problemId, role])
}
model ProgramRevision {
  id String @id @default(cuid())
  programId String
  program Program @relation("ProgramHistory", fields: [programId], references: [id], onDelete: Cascade)
  version Int
  source String @db.Text
  hash String
  configuration Json
  currentFor Program? @relation("CurrentProgramRevision")
  createdAt DateTime @default(now())
  @@unique([programId, version])
}
model TestCase {
  id String @id @default(cuid())
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  number Int
  groupName String @default("main")
  isSample Boolean @default(false)
  enabled Boolean @default(true)
  notes String @default("")
  version Int @default(1)
  currentRevisionId String? @unique
  currentRevision TestCaseRevision? @relation("CurrentTestRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  revisions TestCaseRevision[] @relation("TestHistory")
  createdAt DateTime @default(now())
  deletedAt DateTime?
  // Live numbers are unique via the partial index in 20261001050000_test_deletion.
  @@index([problemId, deletedAt, number])
}
model TestCaseRevision {
  id String @id @default(cuid())
  testCaseId String
  testCase TestCase @relation("TestHistory", fields: [testCaseId], references: [id], onDelete: Cascade)
  version Int
  inputKey String
  inputHash String
  inputBytes Int
  answerKey String?
  answerHash String?
  answerBytes Int?
  provenance Json
  configuration Json
  currentFor TestCase? @relation("CurrentTestRevision")
  createdAt DateTime @default(now())
  @@unique([testCaseId, version])
}
model GeneratorPlan {
  id String @id @default(cuid())
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  programId String
  program Program @relation(fields: [programId], references: [id])
  name String
  version Int @default(1)
  enabled Boolean @default(true)
  data Json
  hash String
  revisions GeneratorPlanRevision[]
  createdAt DateTime @default(now())
  @@index([problemId])
}
model GeneratorPlanRevision {
  id String @id @default(cuid())
  planId String
  plan GeneratorPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  version Int
  data Json
  hash String
  createdAt DateTime @default(now())
  @@unique([planId, version])
}
model ToolSelfTest {
  id String @id @default(cuid())
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  programId String?
  program Program? @relation(fields: [programId], references: [id])
  kind String
  name String
  expected String
  enabled Boolean @default(true)
  version Int @default(1)
  data Json
  hash String
  revisions ToolSelfTestRevision[]
  createdAt DateTime @default(now())
  @@index([problemId])
}
model ToolSelfTestRevision {
  id String @id @default(cuid())
  selfTestId String
  selfTest ToolSelfTest @relation(fields: [selfTestId], references: [id], onDelete: Cascade)
  version Int
  data Json
  hash String
  createdAt DateTime @default(now())
  @@unique([selfTestId, version])
}
model TestRun {
  id String @id @default(cuid())
  leaseToken String?
  heartbeatAt DateTime?
  retryOfId String? @unique
  retryCount Int @default(0)
  updatedAt DateTime @default(now()) @updatedAt
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy User @relation(fields: [requestedById], references: [id])
  requestKey String @unique
  purpose JudgePurpose
  state BuildState @default(QUEUED)
  input Json
  inputHash String
  dependencyHash String
  accepted Boolean?
  report Json?
  completed Int @default(0)
  total Int @default(0)
  stage String @default("等待入队")
  log String @default("") @db.Text
  errorCode String?
  cancelRequested Boolean @default(false)
  queuedAt DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  cases RunCase[]
  invocations Invocation[]
  @@index([state, queuedAt])
  @@index([problemId, createdAt])
  @@index([requestedById, createdAt, id])
  @@index([problemId, createdAt, id])
}
model RunCase {
  id String @id @default(cuid())
  runId String
  run TestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  ref String
  number Int
  groupName String
  isSample Boolean @default(false)
  inputKey String
  inputHash String
  inputBytes Int
  answerKey String?
  answerHash String?
  answerBytes Int?
  origin Json
  validation String @default("NOT_RUN")
  @@unique([runId, ref])
}
model Invocation {
  id String @id @default(cuid())
  runId String
  run TestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  programId String?
  programRevisionId String?
  caseRef String?
  selfTestId String?
  phase String
  verdict String
  status String
  exitStatus Int
  timeMs Float
  wallTimeMs Float
  memoryBytes Int
  stdoutKey String?
  stdoutHash String?
  stdoutBytes Int @default(0)
  stderrKey String?
  stderrBytes Int @default(0)
  diagnostic String @default("") @db.Text
  detail Json?
  createdAt DateTime @default(now())
  @@index([runId, phase])
}
