generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum SystemRole {
  ADMIN
  USER
}
enum ResourceRole {
  OWNER
  EDITOR
  REVIEWER
  VIEWER
}
enum DocumentKind {
  STATEMENT
  EDITORIAL_DOCUMENT
  EDITORIAL_BEAMER
}
enum TemplateState {
  DRAFT
  VALIDATED
  PUBLISHED
  ARCHIVED
  REVOKED
}
enum BuildState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role SystemRole @default(USER)
  disabled Boolean @default(false)
  createdAt DateTime @default(now())
  sessions Session[]
  memberships ProblemMember[]
  builds Build[]
  testRuns TestRun[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model Problem {
  id String @id @default(cuid())
  title String
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members ProblemMember[]
  documents Document[]
  assets Asset[]
  judgeVersion Int @default(1)
  judgeSettings Json?
  programs Program[]
  tests TestCase[]
  generatorPlans GeneratorPlan[]
  selfTests ToolSelfTest[]
  testRuns TestRun[]
}
model ProblemMember {
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role ResourceRole
  @@id([problemId, userId])
}
model Document {
  id String @id @default(cuid())
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language String
  kind DocumentKind
  enabled Boolean @default(true)
  version Int @default(1)
  currentRevisionId String? @unique
  currentRevision ContentRevision? @relation("CurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  templateVersionId String?
  templateVersion TemplateVersion? @relation(fields: [templateVersionId], references: [id])
  revisions ContentRevision[] @relation("DocumentHistory")
  publications Publication[]
  updatedAt DateTime @updatedAt
  @@unique([problemId, language, kind])
}
model ContentRevision {
  id String @id @default(cuid())
  documentId String
  document Document @relation("DocumentHistory", fields: [documentId], references: [id], onDelete: Cascade)
  version Int
  body String @db.Text
  metadata Json
  sampleRevisionIds String[] @default([])
  hash String
  createdAt DateTime @default(now())
  currentFor Document? @relation("CurrentRevision")
  @@unique([documentId, version])
}
model Template {
  id String @id @default(cuid())
  name String
  kind DocumentKind
  createdAt DateTime @default(now())
  versions TemplateVersion[]
}
model TemplateVersion {
  id String @id @default(cuid())
  templateId String
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  number Int
  editVersion Int @default(1)
  state TemplateState @default(DRAFT)
  files Json
  styleConfig Json?
  hash String
  validationBuildId String?
  validationBuildHash String?
  publishedAt DateTime?
  reason String?
  createdAt DateTime @default(now())
  documents Document[]
  @@unique([templateId, number])
}
model Build {
  id String @id @default(cuid())
  requestedById String
  requestedBy User @relation(fields: [requestedById], references: [id])
  problemId String?
  documentId String?
  revisionId String?
  templateVersionId String
  kind DocumentKind
  purpose String @default("DOCUMENT")
  state BuildState @default(QUEUED)
  input Json
  inputHash String
  log String @default("") @db.Text
  diagnostics Json?
  errorCode String?
  queuedAt DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  cancelRequested Boolean @default(false)
  createdAt DateTime @default(now())
  artifacts Artifact[]
  publications Publication[]
  @@index([state, queuedAt])
  @@index([problemId, documentId, createdAt])
}
model Artifact {
  id String @id @default(cuid())
  buildId String
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)
  key String @unique
  mediaType String
  hash String
  bytes Int
  createdAt DateTime @default(now())
}
model Asset {
  id String @id @default(cuid())
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  name String
  key String @unique
  mediaType String
  hash String
  bytes Int
  createdAt DateTime @default(now())
}
model Publication {
  id String @id @default(cuid())
  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  buildId String
  build Build @relation(fields: [buildId], references: [id])
  token String @unique
  revokedAt DateTime?
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  resourceId String?
  detail Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
enum ProgramRole {
  MAIN_SOLUTION
  CORRECT_SOLUTION
  WRONG_SOLUTION
  TIME_LIMIT_SOLUTION
  BRUTE_FORCE
  GENERATOR
  VALIDATOR
  EXTRA_VALIDATOR
  CHECKER
  INTERACTOR
}
enum ProgramLanguage {
  CPP17
  CPP20
  PYTHON3
}
enum JudgePurpose {
  COMPILE
  GENERATE
  VALIDATE
  ANSWERS
  SELF_TEST
  ACCEPTANCE
}
model CompileProfile {
  id String @id
  name String
  language ProgramLanguage
  version Int @default(1)
  enabled Boolean @default(true)
  config Json
  hash String
  updatedAt DateTime @updatedAt
  programs Program[]
}
model Program {
  id String @id @default(cuid())
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  name String
  role ProgramRole
  profileId String
  profile CompileProfile @relation(fields: [profileId], references: [id])
  expectedVerdicts Json
  notes String @default("")
  enabled Boolean @default(true)
  version Int @default(1)
  currentRevisionId String? @unique
  currentRevision ProgramRevision? @relation("CurrentProgramRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  revisions ProgramRevision[] @relation("ProgramHistory")
  plans GeneratorPlan[]
  selfTests ToolSelfTest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([problemId, role])
}
model ProgramRevision {
  id String @id @default(cuid())
  programId String
  program Program @relation("ProgramHistory", fields: [programId], references: [id], onDelete: Cascade)
  version Int
  source String @db.Text
  hash String
  configuration Json
  currentFor Program? @relation("CurrentProgramRevision")
  createdAt DateTime @default(now())
  @@unique([programId, version])
}
model TestCase {
  id String @id @default(cuid())
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  number Int
  groupName String @default("main")
  isSample Boolean @default(false)
  enabled Boolean @default(true)
  notes String @default("")
  version Int @default(1)
  currentRevisionId String? @unique
  currentRevision TestCaseRevision? @relation("CurrentTestRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  revisions TestCaseRevision[] @relation("TestHistory")
  createdAt DateTime @default(now())
  @@unique([problemId, number])
}
model TestCaseRevision {
  id String @id @default(cuid())
  testCaseId String
  testCase TestCase @relation("TestHistory", fields: [testCaseId], references: [id], onDelete: Cascade)
  version Int
  inputKey String
  inputHash String
  inputBytes Int
  answerKey String?
  answerHash String?
  answerBytes Int?
  provenance Json
  configuration Json
  currentFor TestCase? @relation("CurrentTestRevision")
  createdAt DateTime @default(now())
  @@unique([testCaseId, version])
}
model GeneratorPlan {
  id String @id @default(cuid())
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  programId String
  program Program @relation(fields: [programId], references: [id])
  name String
  version Int @default(1)
  enabled Boolean @default(true)
  data Json
  hash String
  revisions GeneratorPlanRevision[]
  createdAt DateTime @default(now())
  @@index([problemId])
}
model GeneratorPlanRevision {
  id String @id @default(cuid())
  planId String
  plan GeneratorPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  version Int
  data Json
  hash String
  createdAt DateTime @default(now())
  @@unique([planId, version])
}
model ToolSelfTest {
  id String @id @default(cuid())
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  programId String?
  program Program? @relation(fields: [programId], references: [id])
  kind String
  name String
  expected String
  enabled Boolean @default(true)
  version Int @default(1)
  data Json
  hash String
  revisions ToolSelfTestRevision[]
  createdAt DateTime @default(now())
  @@index([problemId])
}
model ToolSelfTestRevision {
  id String @id @default(cuid())
  selfTestId String
  selfTest ToolSelfTest @relation(fields: [selfTestId], references: [id], onDelete: Cascade)
  version Int
  data Json
  hash String
  createdAt DateTime @default(now())
  @@unique([selfTestId, version])
}
model TestRun {
  id String @id @default(cuid())
  problemId String
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy User @relation(fields: [requestedById], references: [id])
  requestKey String @unique
  purpose JudgePurpose
  state BuildState @default(QUEUED)
  input Json
  inputHash String
  dependencyHash String
  accepted Boolean?
  report Json?
  completed Int @default(0)
  total Int @default(0)
  stage String @default("等待入队")
  log String @default("") @db.Text
  errorCode String?
  cancelRequested Boolean @default(false)
  queuedAt DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  cases RunCase[]
  invocations Invocation[]
  @@index([state, queuedAt])
  @@index([problemId, createdAt])
}
model RunCase {
  id String @id @default(cuid())
  runId String
  run TestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  ref String
  number Int
  groupName String
  isSample Boolean @default(false)
  inputKey String
  inputHash String
  inputBytes Int
  answerKey String?
  answerHash String?
  answerBytes Int?
  origin Json
  validation String @default("NOT_RUN")
  @@unique([runId, ref])
}
model Invocation {
  id String @id @default(cuid())
  runId String
  run TestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  programId String?
  programRevisionId String?
  caseRef String?
  selfTestId String?
  phase String
  verdict String
  status String
  exitStatus Int
  timeMs Float
  wallTimeMs Float
  memoryBytes Int
  stdoutKey String?
  stdoutHash String?
  stdoutBytes Int @default(0)
  stderrKey String?
  stderrBytes Int @default(0)
  diagnostic String @default("") @db.Text
  detail Json?
  createdAt DateTime @default(now())
  @@index([runId, phase])
}
