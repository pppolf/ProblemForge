# Install on the cloud host only after setting a real hostname and certificate.
# API_TRUSTED_PROXIES must contain the actual proxy peer address seen by the API
# container. Docker port forwarding may use a bridge gateway, not 127.0.0.1.
server {
    listen 80;
    server_name problemforge.example.org;
    return 308 https://problemforge.example.org$request_uri;
}

server {
    listen 443 ssl;
    server_name problemforge.example.org;
    ssl_certificate /etc/ssl/problemforge/fullchain.pem;
    ssl_certificate_key /etc/ssl/problemforge/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Includes base64 JSON overhead for test files and package imports.
    # API-specific limits still apply.
    client_max_body_size 40m;

    location / {
        proxy_pass http://127.0.0.1:5181;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Replace client-provided forwarding headers for this single-proxy setup.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
